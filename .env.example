# Copy this file to .env
# Multiple Google Maps / Places API keys are supported. Separate keys with |.
# Example: GOOGLE_MAPS_API_KEYS=key_one|key_two|key_three
GOOGLE_MAPS_API_KEYS=
# GOOGLE_MAPS_API_KEY is still accepted for backwards compatibility.
POLLINATIONS_URL=https://text.pollinations.ai
SEARXNG_URLS=https://search.undertale.uk/
HOST=0.0.0.0
PORT=8000
MAX_LEADS=240
REQUEST_TIMEOUT=12
MAPS_TIMEOUT=15
ENRICH_TIMEOUT=8
