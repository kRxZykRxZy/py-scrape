# Copy this file to .env
# Single key or multiple keys: separate multiple values with |
GOOGLE_MAPS_API_KEYS=
# GOOGLE_MAPS_API_KEY also works for one key
FOURSQUARE_API_KEYS=
# FOURSQUARE_API_KEY also works for one key
YELP_API_KEYS=
# YELP_API_KEY also works for one key
SEARCH_PROVIDER_ORDER=google,foursquare,yelp,osm
# Keyless fallback endpoints; pipe-separated for failover
OVERPASS_URLS=https://overpass-api.de/api/interpreter|https://overpass.kumi.systems/api/interpreter
POLLINATIONS_URL=https://text.pollinations.ai
SEARXNG_URLS=https://search.undertale.uk/
HOST=0.0.0.0
PORT=8000
MAX_LEADS=240
REQUEST_TIMEOUT=12
MAPS_TIMEOUT=15
ENRICH_TIMEOUT=8
